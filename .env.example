# Configuration for xvd. All variables are optional and have sane defaults,
# so the tool runs immediately after `uv sync` with no .env file at all.
#
# Precedence: --output-dir flag > environment variable > default.

# Where finished video files are written.
# Default: the current working directory.
# The directory is created if it does not exist.
#
# Server configuration only. The HTTP API never accepts an output location from
# a request, and backend/jobs.py calls config.output_dir() with no argument so
# there is no parameter a request body could be wired into.
XVD_OUTPUT_DIR=.

# ---------------------------------------------------------------------------
# HTTP API (feature 002). Everything below is optional and defaulted.
# ---------------------------------------------------------------------------

# Where job records and the submission audit log are kept.
# Default: <XVD_OUTPUT_DIR>/.xvd-state, created with mode 0700.
# Job files are named by the job handle, and a handle is the only credential
# there is -- anyone who can read this directory can fetch any caller's file.
XVD_STATE_DIR=

# How many downloads may run at once. This is the whole concurrency limit:
# it is the thread pool's size, and there is no second mechanism.
# Submissions beyond it wait rather than being dropped.
# Default: 2
XVD_MAX_CONCURRENT=2

# How many jobs may sit in `waiting` before new submissions are refused with
# "at capacity". Set FAR above XVD_MAX_CONCURRENT on purpose: over-limit
# submissions are supposed to wait, and only the far tail is refused. The cap
# exists because the per-address rate limit below bounds one caller but not the
# total across many addresses, which would otherwise be a memory-exhaustion
# path on a public service.
# Default: 50
XVD_MAX_PENDING=50

# How long a single job may run before it is stopped and reported as failed
# with the time-limit reason, in seconds. Measured from when the download
# STARTS, not from when it was submitted, so time spent queued is not charged
# against it.
#
# Known limitation: this is enforced from the download's progress callback, and
# a download hung inside the ffmpeg merge reports no progress. Such a job is
# still failed on schedule, so no caller waits forever -- but its worker thread
# stays occupied until the service restarts. Watch `wedged_workers` on /health;
# a non-zero value means capacity has been permanently reduced and only a
# restart will recover it.
# Default: 1800 (30 minutes)
XVD_JOB_TIMEOUT=1800

# Refuse new submissions when free space on the output volume is below this
# many bytes. Checked BEFORE a job is created, so the service refuses cleanly
# instead of failing halfway through a transfer. It cannot predict the size of
# the file about to be downloaded, so a download can still exhaust the disk
# while running -- that ends as a failed job with a named reason.
#
# Set to 0 to disable the check entirely, which is the right answer on a volume
# whose free-space figure is not meaningful.
# Default: 2147483648 (2 GB)
XVD_MIN_FREE_BYTES=2147483648

# How many submissions one calling address may make per window, and how long
# that window is in seconds. A refusal carries a Retry-After header.
#
# Counted per SUBMISSION, not per job created: an invalid URL and a duplicate
# submission both consume allowance. That is deliberate -- an uncounted invalid
# URL would be a free, unlimited abuse route -- but it does mean a caller who
# mistypes XVD_RATE_LIMIT times is refused for the rest of the window.
#
# The counters live in memory and reset when the service restarts.
# Read backend/jobs.py's `_rate_limited` before tuning these.
# Defaults: 10 per 3600 seconds
XVD_RATE_LIMIT=10
XVD_RATE_WINDOW=3600

# How long a finished job's file is kept before it is deleted, in seconds.
#
# Measured from when the JOB completed, not from the file's timestamp on disk.
# A job that finished instantly by reusing a file an earlier CLI run left
# behind therefore gets a full period from its own completion -- handing
# someone a file and deleting it moments later cannot happen.
#
# The job then reports `expired`, which is distinct from `failed`, and a
# request for its file returns 410 rather than a partial or empty body.
#
# A file can outlive this by up to one XVD_SWEEP_INTERVAL, since deletion
# happens on the sweep rather than on a timer per file.
# Default: 86400 (24 hours)
XVD_RETENTION=86400

# How often the maintenance sweep runs, in seconds. The sweep fails jobs past
# their deadline, expires and deletes files past their retention period, and
# prunes rate-limit state.
# Default: 900 (15 minutes)
XVD_SWEEP_INTERVAL=900

# How much the service says about itself. One of CRITICAL, ERROR, WARNING,
# INFO, DEBUG (case-insensitive). An unrecognised value logs a warning and
# falls back to INFO rather than refusing to start.
#
# Leave this at INFO unless you have a reason. It is the level at which the
# service logs, for each failed job, the downloader's own explanation alongside
# the job handle -- which is the only thing connecting the short sentence a
# caller was shown to the actual reason. At WARNING you keep the operational
# alarms and lose every "why did this job fail" answer.
#
# Lines go to stderr as:
#     2026-08-15 12:33:32,031 INFO     xvd.jobs: job <handle> failed: <reason>
#
# uvicorn's own logging is untouched by this; it keeps its own format and its
# own --log-level.
# Default: INFO
XVD_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# WHO THE SERVICE THINKS YOU ARE  (verified against uvicorn 0.52.2)
#
# The application reads the caller's address from the connection and NEVER from
# a header. Deciding whether a proxy header may be believed is uvicorn's job,
# not the application's, because only the operator knows what sits in front.
#
# uvicorn's defaults, read from uvicorn/config.py:355-357:
#
#     proxy_headers        = True          <- ON by default
#     forwarded_allow_ips  = "127.0.0.1"   <- or $FORWARDED_ALLOW_IPS
#
# So X-Forwarded-For IS honoured out of the box, but only for connections
# arriving from 127.0.0.1. Three cases follow, and only one needs a flag:
#
# 1. Reverse proxy on the SAME host (the usual nginx setup).
#    Nothing to do. The proxy connects from 127.0.0.1 and is already trusted.
#
# 2. Reverse proxy on a DIFFERENT host.
#    uv run uvicorn backend.api:app --forwarded-allow-ips=<the proxy's IP>
#    Without this the proxy is not trusted, every caller collapses into the
#    proxy's single address, and the audit log becomes worthless for the abuse
#    investigation it exists to support.
#
# 3. NO proxy -- the service is exposed directly.
#    uv run uvicorn backend.api:app --no-proxy-headers
#    Turn it OFF. Otherwise anything that can reach the port from 127.0.0.1 --
#    another local process, a container sharing the network namespace, an SSH
#    tunnel someone opened -- can set its own address in a header and both
#    forge the audit trail and escape a per-address rate limit.
#
# NEVER --forwarded-allow-ips='*' or FORWARDED_ALLOW_IPS='*'. That believes the
# header from anyone who can reach the port, which is the same as not checking.
#
# Whichever case applies, confirm it before trusting the log:
#     tail -1 "$XVD_STATE_DIR/submissions.log"
# client_address must be the real caller.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Accepted post hostnames (NOT configurable -- listed here for reference only).
#
# The allowlist is deliberately compiled into backend/validation.py rather than
# read from the environment. It is the Constitution Principle V boundary, and a
# security control that can be widened by an environment variable is not a
# security control. All eight, matched exactly:
#
#   x.com            www.x.com            m.x.com            mobile.x.com
#   twitter.com      www.twitter.com      m.twitter.com      mobile.twitter.com
#
# Rejected: t.co and other shorteners, any .onion mirror, and look-alike hosts
# such as x.com.evil.net.
# ---------------------------------------------------------------------------

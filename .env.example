# Configuration for xvd. All variables are optional and have sane defaults,
# so the tool runs immediately after `uv sync` with no .env file at all.
#
# Precedence: --output-dir flag > environment variable > default.

# Where finished video files are written.
# Default: the current working directory.
# The directory is created if it does not exist.
#
# Server configuration only. The HTTP API never accepts an output location from
# a request, and backend/jobs.py calls config.output_dir() with no argument so
# there is no parameter a request body could be wired into.
XVD_OUTPUT_DIR=.

# ---------------------------------------------------------------------------
# HTTP API (feature 002). Everything below is optional and defaulted.
# ---------------------------------------------------------------------------

# Where job records and the submission audit log are kept.
# Default: <XVD_OUTPUT_DIR>/.xvd-state, created with mode 0700.
# Job files are named by the job handle, and a handle is the only credential
# there is -- anyone who can read this directory can fetch any caller's file.
XVD_STATE_DIR=

# How many downloads may run at once. This is the whole concurrency limit:
# it is the thread pool's size, and there is no second mechanism.
# Submissions beyond it wait rather than being dropped.
# Default: 2
XVD_MAX_CONCURRENT=2

# ---------------------------------------------------------------------------
# WHO THE SERVICE THINKS YOU ARE  (verified against uvicorn 0.52.2)
#
# The application reads the caller's address from the connection and NEVER from
# a header. Deciding whether a proxy header may be believed is uvicorn's job,
# not the application's, because only the operator knows what sits in front.
#
# uvicorn's defaults, read from uvicorn/config.py:355-357:
#
#     proxy_headers        = True          <- ON by default
#     forwarded_allow_ips  = "127.0.0.1"   <- or $FORWARDED_ALLOW_IPS
#
# So X-Forwarded-For IS honoured out of the box, but only for connections
# arriving from 127.0.0.1. Three cases follow, and only one needs a flag:
#
# 1. Reverse proxy on the SAME host (the usual nginx setup).
#    Nothing to do. The proxy connects from 127.0.0.1 and is already trusted.
#
# 2. Reverse proxy on a DIFFERENT host.
#    uv run uvicorn backend.api:app --forwarded-allow-ips=<the proxy's IP>
#    Without this the proxy is not trusted, every caller collapses into the
#    proxy's single address, and the audit log becomes worthless for the abuse
#    investigation it exists to support.
#
# 3. NO proxy -- the service is exposed directly.
#    uv run uvicorn backend.api:app --no-proxy-headers
#    Turn it OFF. Otherwise anything that can reach the port from 127.0.0.1 --
#    another local process, a container sharing the network namespace, an SSH
#    tunnel someone opened -- can set its own address in a header and both
#    forge the audit trail and escape a per-address rate limit.
#
# NEVER --forwarded-allow-ips='*' or FORWARDED_ALLOW_IPS='*'. That believes the
# header from anyone who can reach the port, which is the same as not checking.
#
# Whichever case applies, confirm it before trusting the log:
#     tail -1 "$XVD_STATE_DIR/submissions.log"
# client_address must be the real caller.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Accepted post hostnames (NOT configurable -- listed here for reference only).
#
# The allowlist is deliberately compiled into backend/validation.py rather than
# read from the environment. It is the Constitution Principle V boundary, and a
# security control that can be widened by an environment variable is not a
# security control. All eight, matched exactly:
#
#   x.com            www.x.com            m.x.com            mobile.x.com
#   twitter.com      www.twitter.com      m.twitter.com      mobile.twitter.com
#
# Rejected: t.co and other shorteners, any .onion mirror, and look-alike hosts
# such as x.com.evil.net.
# ---------------------------------------------------------------------------
